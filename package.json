{
  "name": "@quilt/evolve",
  "version": "0.1.0",
  "description": "Self-improvement loops for Quilt. LLMs as adversarial input generators and output judges. Evolve any scope \u2014 a cell, an organ, or a whole organism.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./loop": "./dist/loop.js",
    "./generator": "./dist/generator.js",
    "./judge": "./dist/judge.js",
    "./mutate": "./dist/mutate.js",
    "./scope": "./dist/scope.js",
    "./system": "./dist/system.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node test/*.test.js",
    "witness": "node witness/ledger.js",
    "witness:verify": "node witness/ledger.js --verify",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "quilt",
    "reactive",
    "evolution",
    "rlaif",
    "self-improvement",
    "adversarial",
    "llm",
    "optimization"
  ],
  "author": "SuperInstance",
  "license": "MIT",
  "dependencies": {
    "@quilt/core": "file:../quilt/packages/core",
    "@quilt/ai": "file:../quilt-ai"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "@types/node": "^26.2.0"
  },
  "engines": {
    "node": ">=18"
  }
}
